# The backend. Behind Nginx (deploy/nginx/ponleu-news.conf) it is the public address of the site itself, because Nginx sends
# /api and /uploads to the backend; in development it is the backend on its own port.
VITE_API_URL=http://localhost:8080

# The public address of the site (no trailing slash): the share buttons share {this}/news/{slug}, and index.html uses it for
# the address of the default share image. Set it to the real address in production. Without it the share buttons use the
# address of the open page and the default share image has no address.
VITE_PUBLIC_SITE_URL=https://ponleunews.com
